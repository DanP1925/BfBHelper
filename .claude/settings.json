{
  "permissions": {
    "allow": [
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(npx --no-install tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npx eslint --max-warnings=0 src)",
      "Bash(npx --no-install eslint . --max-warnings=0)",
      "Bash(npm run lint)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\n\" http://localhost:3000)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint-edited-file.sh",
            "timeout": 60,
            "statusMessage": "Formatting and linting edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-frontend.sh",
            "timeout": 120,
            "statusMessage": "Type-checking frontend"
          }
        ]
      }
    ]
  }
}
